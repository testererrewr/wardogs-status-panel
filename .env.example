# Public URL incl. port if direct mode is used.
PUBLIC_URL=http://203.0.113.10:3000
PORT=3000
PANEL_BIND=0.0.0.0:3000

SESSION_SECRET=CHANGE_ME
APP_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
RUNNER_SHARED_SECRET=CHANGE_ME
RUNNER_URL=http://runner:4000

DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
ADMIN_DISCORD_IDS=

# New Discord users can self-register.
ALLOW_PUBLIC_REGISTRATION=true
DEFAULT_STATUS_BOT_LIMIT=1
CUSTOM_UPLOAD_MAX_MB=5

TRUST_PROXY=false
COOKIE_SECURE=false

# Leave empty for direct IP:3000 mode. Use "proxy" for included Caddy.
COMPOSE_PROFILES=
